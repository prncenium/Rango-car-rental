NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rango?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173

# Generate real values, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
# Must differ from each other and from these placeholders (server/src/config/env.ts rejects both).
JWT_ACCESS_SECRET=replace-this-with-a-random-value-of-at-least-32-bytes
JWT_REFRESH_SECRET=replace-this-with-a-different-random-value-32-bytes-min

# Optional: accepted for verification only, to support secret rotation without a mass logout.
# JWT_ACCESS_SECRET_PREVIOUS=

# Cloudinary — car photo storage (docs/design/02-image-storage.md). From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
